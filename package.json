{
  "name": "pilotage-financier-bien-etre-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && tsup server/index.ts --format esm --platform node --out-dir dist-server --external better-sqlite3",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.2.0",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "lucide-react": "0.539.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.1.2",
    "stripe": "22.4.0",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.1.0",
    "tsx": "4.20.5",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
