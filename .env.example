# Le serveur écoute uniquement en local par défaut.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data

# Qonto — OAuth lecture seule recommandé (scope organization.read)
QONTO_ACCESS_TOKEN=

# Alternative mono-entreprise par clé API Qonto
QONTO_API_LOGIN=
QONTO_API_SECRET=

# Stripe — utiliser une Restricted API Key en lecture seule (préfixe rk_)
# Permissions minimales : Subscriptions Read, Prices Read, Products Read, Customers Read.
STRIPE_RESTRICTED_KEY=

